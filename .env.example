# Copy to ~/.config/meetingbot/.env (or .env in this folder) and fill in.

# Free key from https://build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=

# Optional overrides (defaults shown)
# MBOT_NIM_MODEL=openai/gpt-oss-120b
# Reasoning effort for gpt-oss: low (default, fast) | medium | high | none
# MBOT_NIM_REASONING=low
# MBOT_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# MBOT_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# MBOT_NOTES_DIR=/path/to/notes
# MBOT_DATA_DIR=~/.local/share/meetingbot
# MBOT_CHUNK_SECONDS=30

# --- Where to save each meeting note ---
# Comma-separated targets. "markdown" (local file) is always written.
# Add "apple_notes" and/or "google_docs". Example: markdown,apple_notes
# MBOT_EXPORTERS=markdown

# Apple Notes: which folder to file notes in. Put it under your iCloud account
# to sync to cloud + other Apple devices; an "On My Mac" folder stays on-device.
# MBOT_APPLE_NOTES_FOLDER=Meeting Bot

# Google Docs (cloud). Create a "Desktop app" OAuth client in Google Cloud
# Console (enable Docs + Drive APIs), download its JSON, then run `mbot auth-google`.
# MBOT_GOOGLE_CLIENT_SECRETS=~/.config/meetingbot/google_client_secret.json
# MBOT_GOOGLE_TOKEN=~/.config/meetingbot/google_token.json
# MBOT_GOOGLE_DRIVE_FOLDER_ID=         # optional Drive folder to file docs under
