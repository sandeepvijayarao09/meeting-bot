# Copy to ~/.config/meetingbot/.env (or .env in this folder) and fill in.

# Summaries run on-device by default — no key needed, nothing leaves your Mac.
# Fetch the model once with:  mbot download-model --llm

# Optional overrides (defaults shown)
# Backend: local (on-device Gemma 4, default) | cloud (any OpenAI-compatible
# endpoint) | none (transcript-only notes, no generation at all)
# MBOT_LLM_BACKEND=local
# MBOT_GEMMA_MODEL=mlx-community/gemma-4-e4b-it-4bit
# --- cloud backend only; inert unless MBOT_LLM_BACKEND=cloud ---
# MBOT_LLM_API_KEY=
# MBOT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MBOT_LLM_MODEL=gemma-4-e4b-it
# Per-request timeout in seconds (default 90). Bounds a slow/unreachable endpoint so
# summarization fails fast instead of hanging; the note falls back to transcript-only.
# MBOT_LLM_TIMEOUT=90
# MBOT_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# Domain words to spell correctly (product names, jargon, people), comma-separated
# MBOT_VOCAB=Postgres, Kubernetes, OAuth
# Transcript refinement: off (raw) | local (on-device cleanup, default, $0) |
# cloud (local cleanup + an LLM polish pass; opt-in, falls back to local)
# MBOT_REFINE=local
# MBOT_NOTES_DIR=/path/to/notes
# MBOT_DATA_DIR=~/.local/share/meetingbot
# MBOT_CHUNK_SECONDS=30

# --- Where to save each meeting note ---
# Comma-separated targets. "markdown" (local file) is always written.
# Add "apple_notes" and/or "google_docs". Example: markdown,apple_notes
# MBOT_EXPORTERS=markdown

# Apple Notes: which folder to file notes in. Put it under your iCloud account
# to sync to cloud + other Apple devices; an "On My Mac" folder stays on-device.
# MBOT_APPLE_NOTES_FOLDER=Meeting Bot

# Google Docs (cloud). Create a "Desktop app" OAuth client in Google Cloud
# Console (enable Docs + Drive APIs), download its JSON, then run `mbot auth-google`.
# MBOT_GOOGLE_CLIENT_SECRETS=~/.config/meetingbot/google_client_secret.json
# MBOT_GOOGLE_TOKEN=~/.config/meetingbot/google_token.json
# MBOT_GOOGLE_DRIVE_FOLDER_ID=         # optional Drive folder to file docs under
